<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- Ventana modal para AÑADIR un nuevo autor – Controller: AddAutorController -->
<!-- EXAMEN: abierta desde handleAnyadir() con FXMLLoader + APPLICATION_MODAL + showAndWait() -->

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sequeros.practicaexamenterceraevaluacion.AddAutorController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Formulario: col 0 = etiquetas, col 1 = campos -->
    <GridPane hgap="10.0" vgap="12.0">
        <columnConstraints>
            <ColumnConstraints minWidth="90.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="2" />
        <TextField fx:id="nameField" promptText="Nombre" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <Label text="Apellidos:" GridPane.rowIndex="3" />
        <TextField fx:id="subField" promptText="Apellidos" GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Formato dd/MM/yyyy – validado con DateTimeFormatter -->
        <Label text="Nacimiento:" GridPane.rowIndex="4" />
        <TextField fx:id="dateField" promptText="DD/MM/AAAA" GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- "H" → man.png  /  "M" → woman.png en la columna generoColum -->
        <Label text="Género (H/M):" GridPane.rowIndex="5" />
        <TextField fx:id="generoField" promptText="H o M" GridPane.columnIndex="1" GridPane.rowIndex="5" />

        <!-- Debe coincidir con el nombre del .png de la bandera (ej: Spain) -->
        <Label text="País:" GridPane.rowIndex="6" />
        <TextField fx:id="paisField" promptText="Spain, China, Canada..." GridPane.columnIndex="1" GridPane.rowIndex="6" />
      <Label text="Email:" GridPane.rowIndex="1" />
      <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <!-- Botones: onAction conecta con los @FXML del controlador -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="salvarButton" onAction="#handleSalvar" prefWidth="80.0" text="Salvar" />
        <Button fx:id="cancelarButton" onAction="#handleCancelar" prefWidth="80.0" text="Cancelar" />
    </HBox>

</VBox>
