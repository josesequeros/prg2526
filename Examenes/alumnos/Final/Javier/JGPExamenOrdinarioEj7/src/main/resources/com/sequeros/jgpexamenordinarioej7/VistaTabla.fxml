<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="477.0" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sequeros.jgpexamenordinarioej7.VistaTablaControlador">
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="selectedItem">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Label>
            <AnchorPane prefHeight="200.0" prefWidth="550.0">
               <children>
                  <Label layoutX="30.0" layoutY="15.0" text="Nombre" />
                  <Label layoutX="30.0" layoutY="50.0" text="Apellidos" />
                  <Label layoutX="30.0" layoutY="120.0" text="Genero" />
                  <Label layoutX="30.0" layoutY="85.0" text="Correo" />
                  <TextField fx:id="nombre" editable="false" layoutX="100.0" layoutY="10.0" />
                  <TextField fx:id="apellidos" editable="false" layoutX="100.0" layoutY="45.0" />
                  <TextField fx:id="correo" editable="false" layoutX="100.0" layoutY="80.0" />
                  <TextField fx:id="genero" editable="false" layoutX="100.0" layoutY="115.0" />
                  <Label layoutX="300.0" layoutY="15.0" text="País" />
                  <ImageView fx:id="imagen" fitHeight="151.0" fitWidth="187.0" layoutX="358.0" layoutY="40.0" pickOnBounds="true" preserveRatio="true" />
                  <TextField fx:id="pais" editable="false" layoutX="354.0" layoutY="10.0" prefHeight="26.0" prefWidth="179.0" />
                  <TextField fx:id="fechaNacimiento" editable="false" layoutX="100.0" layoutY="150.0" />
                  <Label fx:id="etiqueta" layoutX="30.0" layoutY="154.0" text="Nacimiento" />
               </children>
               <padding>
                  <Insets bottom="10.0" />
               </padding>
            </AnchorPane>
         </children>
      </HBox>
   </bottom>
   <left>
      <VBox prefHeight="405.0" prefWidth="29.0" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="botonAdd" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addAccion" text="Añadir" />
            <Button fx:id="botonBorrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#borrarAccion" text="Borrar" />
            <Button fx:id="botonModificar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#modificarAccion" text="Modificar" />
            <Button fx:id="botonCerrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cerrarAccion" text="Cerrar" />
            <Button fx:id="botonGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarAccion" text="Guardar" />
            <Button fx:id="botonPais" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#paisAccion" text="País" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Personas del Mundo">
               <padding>
                  <Insets left="30.0" right="20.0" />
               </padding>
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </HBox>
   </top>
   <center>
      <TableView fx:id="vistaTabla" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colGenero" editable="false" prefWidth="75.0" text="Genero" />
          <TableColumn fx:id="colNombre" editable="false" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colApellidos" editable="false" prefWidth="75.0" text="Apellidos" />
            <TableColumn fx:id="colCorreo" editable="false" prefWidth="75.0" text="Correo" />
            <TableColumn fx:id="colImagen" editable="false" prefWidth="75.0" text="Imagen" />
        </columns>
      </TableView>
   </center>
</BorderPane>
