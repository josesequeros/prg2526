<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AutoresController">
    <top>
        <VBox>
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="Salir Grabando" onAction="#onSalirGrabando"/>
                </Menu>
                <Menu text="Opciones">
                    <MenuItem text="Añadir" onAction="#onAnadir"/>
                    <MenuItem text="Modificar" onAction="#onModificar"/>
                    <MenuItem text="Borrar" onAction="#onBorrar"/>
                </Menu>
            </MenuBar>
            <ToolBar>
                <Button text="Añadir" fx:id="btnAnadir" onAction="#onAnadir"/>
                <Button text="Borrar" fx:id="btnBorrar" onAction="#onBorrar"/>
                <Button text="Salir Grabando" onAction="#onSalirGrabando"/>
            </ToolBar>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tablaAutores" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="100"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
                <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="150"/>
                <TableColumn fx:id="colNacimiento" text="Nacimiento" prefWidth="100"/>
                <TableColumn fx:id="colImagen" text="Imagen" prefWidth="100"/>
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <GridPane hgap="10" vgap="10" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20" left="20" right="20" top="10"/></padding>
            <Label text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="Imagen:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtImagen" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Apellidos:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtApellidos" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Nacimiento:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtNacimiento" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="DD/MM/YYYY"/>

            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.columnSpan="3">
                <Button fx:id="btnModificar" text="Modificar" onAction="#onModificar"/>
                <Button fx:id="btnAplicar" text="Aplicar" onAction="#onAplicar"/>
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#onCancelar"/>
            </HBox>
        </GridPane>
    </bottom>
</BorderPane>