<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="522.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejemplotableviewbd.TableViewController">
   <bottom>
      <HBox minHeight="25.0" prefHeight="25.0" prefWidth="675.0" BorderPane.alignment="CENTER" />
   </bottom>
   <left>
      <VBox prefHeight="405.0" prefWidth="30.0" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <VBox prefWidth="30.0" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="100.0" />
         </padding>
      </VBox>
   </right>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <center>
      <TableView fx:id="vistaTabla" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="generoColumna" prefWidth="75.0" text="Genero" />
          <TableColumn fx:id="nombreColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Nombre" />
          <TableColumn fx:id="apellidosColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Apellidos" />
            <TableColumn fx:id="correoColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Correo" />
            <TableColumn fx:id="imagenColumna" maxWidth="-1.0" minWidth="100.0" prefWidth="-1.0" text="Imagen" />
        </columns>
      </TableView>
   </center>
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="670.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="botonVer" mnemonicParsing="false" onAction="#verAccion" text="Ver Datos">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin>
            </Button>
            <Button fx:id="botonAdd" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addAccion" text="Añadir">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin></Button>
            <Button fx:id="botonModificar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#modificarAccion" text="Modificar">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin></Button>
            <Button fx:id="botonBorrar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#borrarAccion" text="Borrar">
               <HBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </HBox.margin></Button>
         </children>
      </HBox>
   </top>
</BorderPane>
