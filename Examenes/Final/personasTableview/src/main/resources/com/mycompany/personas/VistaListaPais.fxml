<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: lightblue;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.personas.VistaListaPaisControlador">
   <bottom>
      <HBox alignment="CENTER_LEFT" prefHeight="50.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="selectedItem">
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </bottom>
   <left>
      <VBox prefHeight="405.0" prefWidth="29.0" BorderPane.alignment="CENTER" />
   </left>
   <right>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </right>
   <center>
      <TableView fx:id="vistaTabla" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="generoColumna" prefWidth="75.0" text="Genero" />
            <TableColumn fx:id="nombreColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Nombre" />
            <TableColumn fx:id="apellidosColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Apellidos" />
            <TableColumn fx:id="correoColumna" maxWidth="-1.0" minWidth="150.0" prefWidth="-1.0" text="Correo" />
            <TableColumn fx:id="nacimientoColumna" maxWidth="-1.0" minWidth="100.0" prefWidth="-1.0" text="Nacimiento" />
        </columns>
      </TableView>
   </center>
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Personas del Pais">
               <padding>
                  <Insets left="30.0" right="20.0" />
               </padding>
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <ImageView fx:id="imagen" fitHeight="151.0" fitWidth="187.0" pickOnBounds="true" preserveRatio="true" />
         </children>
         <opaqueInsets>
            <Insets />
         </opaqueInsets>
      </HBox>
   </top>
</BorderPane>
